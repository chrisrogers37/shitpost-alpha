+def first_bar(series: MinuteSeries, minutes: Ints) -> tuple[npt.NDArray[np.bool_], Ints, Floats]:
+    """Each minute's first bar at or after it: whether there is one, its start and its
+    open."""
+    n, size = len(series.minutes), len(minutes)
+    if not n:
+        return np.zeros(size, np.bool_), np.zeros(size, np.int64), np.full(size, np.nan)
+    at = np.searchsorted(series.minutes, minutes)
+    here = np.minimum(at, n - 1)
+    return at < n, series.minutes[here], series.opens[here]
+
