{
  "about": "AI picker version settings: the two models (both must agree) and their settings, the window start, and the answer schema. Pinned with the prompt by ai.json. temperature null means the provider takes none. The window starts on the New York day after the latest model cutoff (Haiku 4.5's, July 2025) plus 3 months, at midnight. The prices are in ai_models.json and the reason line in reason.json, outside this version.",
  "models": {
    "openai": {
      "model": "gpt-4.1-2025-04-14",
      "temperature": 0,
      "cutoff": "2024-06-01",
      "cutoff_source": "https://developers.openai.com/api/docs/models/gpt-4.1"
    },
    "anthropic": {
      "model": "claude-haiku-4-5-20251001",
      "temperature": 0,
      "cutoff": "2025-07-31",
      "cutoff_source": "https://platform.claude.com/docs/en/models/overview (training data Jul 2025; reliable knowledge Feb 2025)"
    }
  },
  "settings": {
    "max_output_tokens": 800,
    "timeout_seconds": 15,
    "max_instruments": 8,
    "why_max_chars": 100
  },
  "window_start": "2025-11-01",
  "schema": {
    "type": "object",
    "properties": {
      "market_link": {
        "type": "boolean"
      },
      "instruments": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "ticker": {
              "type": [
                "string",
                "null"
              ]
            },
            "asset": {
              "type": "string",
              "enum": [
                "stock",
                "etf",
                "coin"
              ]
            },
            "link": {
              "type": "string",
              "enum": [
                "explicit",
                "implied"
              ]
            },
            "why": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "ticker",
            "asset",
            "link",
            "why"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "market_link",
      "instruments"
    ],
    "additionalProperties": false
  }
}
